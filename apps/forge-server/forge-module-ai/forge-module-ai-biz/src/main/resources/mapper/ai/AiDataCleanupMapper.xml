<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.forge.modules.ai.agent.lifecycle.AiDataCleanupMapper">

    <!-- 每批上限：OGNL 静态引用接口常量 BATCH_LIMIT（AgentDataCleanupService 也用它判断末批），保持单一来源 -->
    <sql id="batchLimit">LIMIT ${@com.forge.modules.ai.agent.lifecycle.AiDataCleanupMapper@BATCH_LIMIT}</sql>

    <!-- 分批选 id（含保护条件）。run/todo 不带 deleted 条件：逻辑删除的记录同样超期物理清理 -->

    <select id="selectExpiredRunIds" resultType="java.lang.Long">
        SELECT id FROM ai_agent_run
        WHERE status IN ('SUCCEEDED','FAILED','CANCELLED') AND create_time &lt; #{cutoff}
        <include refid="batchLimit"/>
    </select>

    <select id="selectExpiredStepIds" resultType="java.lang.Long">
        SELECT id FROM ai_agent_run_step WHERE create_time &lt; #{cutoff}
        <include refid="batchLimit"/>
    </select>

    <select id="selectOrphanStepIds" resultType="java.lang.Long">
        SELECT s.id FROM ai_agent_run_step s
        LEFT JOIN ai_agent_run r ON s.run_id = r.id
        WHERE r.id IS NULL
        <include refid="batchLimit"/>
    </select>

    <select id="selectExpiredTodoIds" resultType="java.lang.Long">
        SELECT id FROM ai_agent_todo WHERE status &lt;&gt; 'PENDING' AND create_time &lt; #{cutoff}
        <include refid="batchLimit"/>
    </select>

    <select id="selectOrphanTodoIds" resultType="java.lang.Long">
        SELECT t.id FROM ai_agent_todo t
        LEFT JOIN ai_agent_run r ON t.run_id = r.id
        WHERE r.id IS NULL
        <include refid="batchLimit"/>
    </select>

    <select id="selectExpiredCheckpointIds" resultType="java.lang.Long">
        SELECT id FROM ai_agent_checkpoint WHERE create_time &lt; #{cutoff}
        <include refid="batchLimit"/>
    </select>

    <select id="selectOrphanCheckpointIds" resultType="java.lang.Long">
        SELECT c.id FROM ai_agent_checkpoint c
        LEFT JOIN ai_agent_run r ON c.run_id = r.id
        WHERE r.id IS NULL
        <include refid="batchLimit"/>
    </select>

    <!-- 对话数据（ai_chat_conversation / ai_chat_message）：物理删，会话 deleted 列一并无视 -->

    <select id="selectExpiredConversationIds" resultType="java.lang.Long">
        SELECT id FROM ai_chat_conversation WHERE create_time &lt; #{cutoff}
        <include refid="batchLimit"/>
    </select>

    <select id="selectExpiredMessageIds" resultType="java.lang.Long">
        SELECT id FROM ai_chat_message WHERE create_time &lt; #{cutoff}
        <include refid="batchLimit"/>
    </select>

    <select id="selectOrphanMessageIds" resultType="java.lang.Long">
        SELECT m.id FROM ai_chat_message m
        LEFT JOIN ai_chat_conversation c ON m.conversation_id = c.conversation_id
        WHERE c.id IS NULL
        <include refid="batchLimit"/>
    </select>

    <!-- 物理删除：run/todo 实体带 @TableLogic，MP 的 deleteByIds 是逻辑删除，故手写 DELETE -->

    <delete id="deleteRunByIds">
        DELETE FROM ai_agent_run WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteStepByIds">
        DELETE FROM ai_agent_run_step WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteTodoByIds">
        DELETE FROM ai_agent_todo WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteCheckpointByIds">
        DELETE FROM ai_agent_checkpoint WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteConversationByIds">
        DELETE FROM ai_chat_conversation WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteMessageByIds">
        DELETE FROM ai_chat_message WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
