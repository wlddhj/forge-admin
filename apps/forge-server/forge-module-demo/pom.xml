<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forge</groupId>
        <artifactId>forge</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>forge-module-demo</artifactId>
    <name>forge-module-demo</name>
    <description>业务示例模块 - 项目立项接入工作流(形态A)完整对接示例,详见 docs-base/modules/workflow/06.business-integration-guide.md</description>

    <!-- 示例模块刻意不拆 api/biz：无第二消费方，展示形态A的最小依赖姿势；需要跨模块共享 DTO 时再拆 -->

    <dependencies>
        <!-- 工作流门面：WfProcessInstanceService / WfProcessDefinitionService / WorkflowInstanceEvent -->
        <dependency>
            <groupId>com.forge</groupId>
            <artifactId>forge-module-workflow-biz</artifactId>
        </dependency>
        <!-- 撤销时的发起人校验用 SecurityHelper.getCurrentUserId() -->
        <dependency>
            <groupId>com.forge</groupId>
            <artifactId>forge-spring-boot-starter-security</artifactId>
        </dependency>
        <!-- @Async 事件消费线程租户上下文重建用 TenantContextHolder -->
        <dependency>
            <groupId>com.forge</groupId>
            <artifactId>forge-spring-boot-starter-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
