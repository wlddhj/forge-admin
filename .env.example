# ============================================================
# forge-admin 环境变量配置样例
# ============================================================
# 复制此文件为 .env 并按实际环境修改：
#   cp .env.example .env
#
# 用途说明：
#   1. Docker Compose 部署：compose 自动加载根目录 .env（必填项留空会启动失败并明确报错）
#   2. 本地开发：Spring Boot 不自动读取 .env 文件，需覆盖 application.yml
#      默认值时请通过 IDE 或 export 注入同名环境变量
#
# 密钥生成示例：openssl rand -base64 48
# ============================================================

# ---------- 项目基础 ----------
PROJECT_NAME=forge-admin
SPRING_PROFILES_ACTIVE=prod

# ---------- MySQL ----------
# root 密码【必填】：仅 Docker 容器首次初始化（建库/建账号）与数据导入用
MYSQL_ROOT_PASSWORD=
# 业务库与业务账号【Docker 自动创建账号并授权该库】；本地开发直连 root 时自行修改
DB_NAME=forge_admin
DB_USERNAME=forge
# 业务账号密码【必填】
DB_PASSWORD=
# 默认按 Docker 部署（compose 网络内的服务名）；
# 本地开发（mvn spring-boot:run 直连宿主机数据库）时改为 localhost
DB_HOST=mysql
DB_PORT=3306

# ---------- Redis ----------
# 密码【必填】
REDIS_PASSWORD=
REDIS_DATABASE=0
# 默认按 Docker 部署（compose 网络内的服务名）；
# 本地开发（mvn spring-boot:run 直连宿主机 Redis）时改为 localhost
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- 后端安全密钥 ----------
# JWT 签名密钥，至少 256 位（32 字节）【必填，生产必须更换】
# 生成：openssl rand -base64 32
JWT_SECRET=
# 敏感字段 AES-256-GCM 加密密钥（32 字节）【必填，生产必须更换】
# 生成：openssl rand -base64 32
APP_AES_KEY=

# ---------- 服务端口 ----------
SERVER_PORT=8181
BACKEND_PORT=8181
# 前端对外访问端口【Docker】
FRONTEND_PORT=80
# MySQL 宿主机映射端口【仅本地调试/SSH 隧道导数据用，始终绑定 127.0.0.1，不对公网暴露】
# 本机 3306 已被占用时修改；改后手工导入命令的端口需同步（mysql -h 127.0.0.1 -P <此端口>）
MYSQL_EXPOSE_PORT=3306

# ---------- 日志 ----------
LOG_PATH=logs
# debug / info / warn / error【Docker】
LOG_LEVEL=info

# ---------- 文件存储 ----------
# local（默认）/ oss / minio（详见 application-prod.yml）【Docker】
FILE_STORAGE_TYPE=local
FILE_UPLOAD_PATH=./uploads
# 上传文件访问 URL 前缀（上传后文件的回显地址），按实际访问域名/IP修改
# Docker 部署走 nginx 反代（80）；本地开发直连后端用 http://localhost:8181/api/uploads
FILE_BASE_URL=http://localhost/api/uploads

# ---------- 对象存储（FILE_STORAGE_TYPE=oss 时必填） ----------
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=

# ---------- 第三方登录（可选，启用微信/钉钉扫码登录时配置） ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_REDIRECT_URI=

# ============================================================
# Docker 首次部署提示：无需手工导入 SQL —— docker compose up -d 时
# MySQL 容器首次启动（数据卷为空）会自动按序执行 sql/ 下 5 个初始化
# 脚本（init → ai → app → screen → workflow），导入到 DB_NAME 指定的库。
# 仅数据卷为空时执行；重新初始化需先 docker compose down -v 清空卷。
# 增量迁移脚本位于 apps/forge-server/**/db/migration/（无 Flyway，手工执行）：
#   mysql -h 127.0.0.1 -u root -p <DB_NAME> < <迁移脚本路径>
# ============================================================
