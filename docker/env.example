# ============================================================
# forge-admin Docker Compose 环境变量
# 使用：复制本文件为仓库根目录 .env 后填写
#   cp docker/env.example .env
# 生成密钥示例：openssl rand -base64 48
# ============================================================

# ---------- MySQL ----------
# root 密码（必填，仅容器初始化与数据导入用）
MYSQL_ROOT_PASSWORD=
# 业务库名与业务账号（账号自动创建并授权该库）
DB_NAME=forge_admin
DB_USERNAME=forge
# 业务账号密码（必填）
DB_PASSWORD=

# ---------- Redis ----------
# Redis 密码（必填）
REDIS_PASSWORD=

# ---------- 后端安全密钥（必填） ----------
# JWT 签名密钥，至少 256 位（32 字节）
JWT_SECRET=
# 敏感字段 AES-256-GCM 加密密钥（32 字节）
APP_AES_KEY=

# ---------- 文件存储 ----------
# local（默认，挂载 ./uploads）/ oss / minio（详见 application-prod.yml）
FILE_STORAGE_TYPE=local
# 上传文件回显地址，按实际访问域名/IP修改
FILE_BASE_URL=http://localhost/api/uploads

# ---------- 前端 ----------
# 对外访问端口（默认 80）
FRONTEND_PORT=80

# ---------- 日志 ----------
# debug / info / warn / error
LOG_LEVEL=info

# ============================================================
# 首次部署：数据库初始化（宿主机执行，MySQL 已绑 127.0.0.1:3306）
#   mysql -h 127.0.0.1 -u root -p < sql/init.sql
#   mysql -h 127.0.0.1 -u root -p forge_admin < sql/init-workflow.sql
#   mysql -h 127.0.0.1 -u root -p forge_admin < sql/init-ai.sql
#   mysql -h 127.0.0.1 -u root -p forge_admin < sql/init-screen.sql
#   mysql -h 127.0.0.1 -u root -p forge_admin < sql/init-app.sql
# 注意：增量迁移脚本位于 apps/forge-server/**/db/migration/（无 Flyway，需按版本号手工执行）
# ============================================================
