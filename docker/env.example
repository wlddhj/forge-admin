# ============================================================
# forge-admin Docker Compose 环境变量
# 使用：复制本文件为仓库根目录 .env 后填写
#   cp docker/env.example .env
# 生成密钥示例：openssl rand -base64 48
# ============================================================

# ---------- MySQL ----------
# root 密码（必填，仅容器初始化与数据导入用）
MYSQL_ROOT_PASSWORD=
# 业务库名与业务账号（账号自动创建并授权该库）
DB_NAME=forge_admin
DB_USERNAME=forge
# 业务账号密码（必填）
DB_PASSWORD=

# ---------- Redis ----------
# Redis 密码（必填）
REDIS_PASSWORD=

# ---------- 后端安全密钥（必填） ----------
# JWT 签名密钥，至少 256 位（32 字节）
JWT_SECRET=
# 敏感字段 AES-256-GCM 加密密钥（32 字节）
APP_AES_KEY=

# ---------- 文件存储 ----------
# local（默认，挂载 ./uploads）/ oss / minio（详见 application-prod.yml）
FILE_STORAGE_TYPE=local
# 上传文件回显地址，按实际访问域名/IP修改
FILE_BASE_URL=http://localhost/api/uploads

# ---------- 前端 ----------
# 对外访问端口（默认 80）
FRONTEND_PORT=80

# ---------- 日志 ----------
# debug / info / warn / error
LOG_LEVEL=info

# ============================================================
# 首次部署：无需手工导入 SQL —— docker compose up -d 时 MySQL 容器
# 首次启动（数据卷为空）会自动按序执行 sql/ 下 5 个初始化脚本
# （init → ai → app → screen → workflow），导入到 DB_NAME 指定的库。
# 注意：
#   1. 仅数据卷为空时执行；如需重新初始化，先 docker compose down -v 清空卷
#   2. 后续增量迁移脚本位于 apps/forge-server/**/db/migration/
#      （项目未引入 Flyway，需按版本号手工执行）：
#      mysql -h 127.0.0.1 -u root -p <DB_NAME> < <迁移脚本路径>
# ============================================================
